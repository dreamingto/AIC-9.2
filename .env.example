APP_ENV=development
APP_VERSION=0.1.0
PYTHON_BASE_IMAGE=public.ecr.aws/docker/library/python:3.12-slim
POSTGRES_BASE_IMAGE=public.ecr.aws/docker/library/postgres:16
PGVECTOR_PACKAGE_VERSION=0.8.6-1.pgdg13+1
DATABASE_URL=postgresql+asyncpg://tuji:tuji@db:5432/tuji
SYNC_DATABASE_URL=postgresql+psycopg://tuji:tuji@db:5432/tuji
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATA_ROOT=/app/data
MANIFEST_ROOT=/app/data/manifests
ASSET_ROOT=/app/data/assets
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
TOP_K_DEFAULT=10
LOG_LEVEL=INFO
RETRIEVAL_PROFILE=baseline
MODEL_SERVICE_URL=http://host.docker.internal:8767
MODEL_TIMEOUT_SECONDS=60
EAFR_WEIGHTS={"beta_v":0.25,"beta_t":0.25,"beta_r":0.2,"beta_f":0.2,"beta_g":0.05,"lambda_e":0.1,"lambda_u":0.05}
